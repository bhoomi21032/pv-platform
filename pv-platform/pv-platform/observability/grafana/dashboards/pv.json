   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 6,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(pv_triage_source_total{source=\"fallback\"}[1m])) / sum(rate(pv_triage_source_total[1m]))",
